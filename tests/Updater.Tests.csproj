<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- AppSettings carries the kit's AppTheme, and ThemeManager is WPF. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../UpdateService.cs" Link="UpdateService.cs" />
    <Compile Include="../UpdateSchedule.cs" Link="UpdateSchedule.cs" />
    <Compile Include="../UpdateStatus.cs" Link="UpdateStatus.cs" />
    <Compile Include="../AppSettings.cs" Link="AppSettings.cs" />
    <Compile Include="../Changelog.cs" Link="Changelog.cs" />
    <Compile Include="../AlexLV.WindowsUi/ThemeManager.cs" Link="ThemeManager.cs" />
    <EmbeddedResource Include="../CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>
</Project>
