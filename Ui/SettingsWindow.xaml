<ui:ThemedWindow x:Class="MonitorMover.Ui.SettingsWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="720" Height="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- Fixed size; no tab scrolls (windows-apps-common-standards.md, Sectioned Settings). -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
          <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="DirtyText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs">
      <!-- General -->
      <TabItem Header="General" x:Name="GeneralTab">
        <StackPanel>
          <TextBlock Text="Choose how Monitor Mover's windows look. The change previews right away; Save keeps it." Style="{StaticResource LeadText}"/>
          <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <Border Style="{StaticResource FirstCardRow}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Theme"/>
                  <TextBlock Text="System follows the Windows light or dark setting." Style="{StaticResource MutedText}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Updates -->
      <TabItem Header="Updates" x:Name="UpdatesTab">
        <StackPanel>
          <TextBlock Text="Choose when Monitor Mover checks GitHub for newer releases and updates." Style="{StaticResource LeadText}"/>
          <Border Style="{StaticResource Card}" Padding="16">
            <DockPanel>
              <Button x:Name="UpdateNowButton" DockPanel.Dock="Right" Content="Update…" Style="{StaticResource PrimaryButton}"
                      VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" Click="UpdateNow_Click"/>
              <Ellipse x:Name="UpdateDot" Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center" Fill="{DynamicResource Ok}"/>
              <StackPanel>
                <TextBlock x:Name="UpdateTitle" Style="{StaticResource StrongText}"/>
                <TextBlock x:Name="UpdateDetail" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Check for updates" VerticalAlignment="Center" MinWidth="132"/>
              <ComboBox x:Name="Frequency" Margin="10,0,10,0"
                        ToolTip="Check at startup, then at this interval. Never disables automatic checks.">
                <ComboBoxItem Content="Once an hour"/>
                <ComboBoxItem Content="Once a day (default)"/>
                <ComboBoxItem Content="Once a week"/>
                <ComboBoxItem Content="Once a month"/>
                <ComboBoxItem Content="Never"/>
              </ComboBox>
              <Button x:Name="CheckNowButton" Content="Check for updates" Click="CheckNow_Click"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Verified installers" Style="{StaticResource StrongText}" Margin="0,0,0,2"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap"
                         Text="Updates come from official GitHub releases and are verified with SHA-256 before setup runs. Background checks stay quiet when offline; a manual check always reports its result."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Profiles -->
      <TabItem Header="Profiles" x:Name="ProfilesTab">
        <StackPanel>
          <TextBlock Text="Where Monitor Mover keeps your saved monitor layouts." Style="{StaticResource LeadText}"/>
          <TextBlock Text="PROFILES" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource Card}">
            <Border Style="{StaticResource FirstCardRow}">
              <StackPanel>
                <TextBlock Text="Profiles folder" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Margin="10,0,0,0" Click="OpenProfilesFolder_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE838;" Style="{StaticResource ButtonGlyph}"/>
                      <TextBlock Text="Open folder"/>
                    </StackPanel>
                  </Button>
                  <TextBox x:Name="ProfilesFolder" Style="{StaticResource PathBox}"/>
                </DockPanel>
                <TextBlock Text="Profiles are stored in profiles.json in this folder. Upgrades and uninstall keep it."
                           Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- About -->
      <TabItem Header="About" x:Name="AboutTab">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <Image x:Name="AboutIcon" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="AboutTitle" Style="{StaticResource TitleText}"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14">
                <Run x:Name="AboutBuild"/>
                <Hyperlink Click="Repo_Click">github.com/alexlvcom/MonitorMover</Hyperlink>
              </TextBlock>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="NotesHeader" Style="{StaticResource StrongText}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource Card}" Height="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10" Focusable="False">
              <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
          </Border>
          <Button Style="{StaticResource LinkButton}" Content="View full change history" Click="History_Click"
                  HorizontalAlignment="Left" Margin="0,12,0,0"/>
        </StackPanel>
      </TabItem>

      <!-- Diagnostics -->
      <TabItem Header="Diagnostics" x:Name="DiagnosticsTab">
        <StackPanel>
          <TextBlock Text="Where Monitor Mover runs from and keeps its profiles and settings." Style="{StaticResource LeadText}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel x:Name="PathsPanel"/>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Click="CopyDetails_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8C8;" Style="{StaticResource ButtonGlyph}"/>
                  <TextBlock Text="Copy details"/>
                </StackPanel>
              </Button>
              <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="Copy details" Style="{StaticResource StrongText}"/>
                <TextBlock Text="Copies the version, build, these locations and the release notes for a bug report."
                           Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</ui:ThemedWindow>
