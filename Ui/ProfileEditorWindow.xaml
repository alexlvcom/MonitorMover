<ui:ThemedWindow x:Class="MonitorMover.Ui.ProfileEditorWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="1000" Height="560" MinWidth="820" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
          <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Button HorizontalAlignment="Left" Click="RemoveSelected_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonGlyph}"/>
            <TextBlock Text="Remove Selected Rows"/>
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>

    <Grid Margin="20,16,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition x:Name="SplitterRow" Height="0"/>
        <RowDefinition x:Name="DiffRowDefinition" Height="0"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0">
        <TextBlock Text="Profile name" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox x:Name="NameBox"/>
      </DockPanel>
      <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,10"
                 Text="One row per application: every open window of that .exe is sent to its target monitor. Fill in “Title Contains” only to give one particular window a target of its own."/>

      <DataGrid Grid.Row="2" x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                CanUserReorderColumns="False" RowHeight="42" BorderThickness="1">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="On" Width="64">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToggleSwitch}"
                          HorizontalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Process" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Process}" Style="{StaticResource CellText}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Captured Title" Width="*" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding CapturedTitle}" Style="{StaticResource CellText}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Title Contains (optional)" Width="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding TitleContains, UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Target Monitor" Width="220">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding MonitorOptions}" SelectedItem="{Binding TargetMonitor, UpdateSourceTrigger=PropertyChanged}"
                          Margin="6,0" HorizontalAlignment="Stretch"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="State" Width="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding StateOptions}" SelectedItem="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                          Margin="6,0" HorizontalAlignment="Stretch"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Pos / Size" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding PosSize}" Style="{StaticResource MonoCellText}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                    ResizeDirection="Rows" ShowsPreview="False" Focusable="False"/>

      <DockPanel Grid.Row="4" x:Name="DiffPanel" Visibility="Collapsed">
        <Border DockPanel.Dock="Top" x:Name="Banner" CornerRadius="8" Padding="14,10" BorderThickness="1">
          <DockPanel>
            <TextBlock x:Name="BannerGlyph" DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" FontSize="16"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="BannerText" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0" Background="Transparent"
                    MouseLeftButtonUp="ShowUnchangedLabel_Click">
          <CheckBox x:Name="ShowUnchanged" Style="{StaticResource ToggleSwitch}"
                    Checked="ShowUnchanged_Changed" Unchecked="ShowUnchanged_Changed"/>
          <TextBlock Text="Show unchanged apps" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Margin="0,10,0,0">
          <TextBlock x:Name="EmptyNote" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Visibility="Collapsed"/>
          <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                    CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" BorderThickness="1">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="{Binding Back}"/>
                <Setter Property="Foreground" Value="{Binding Fore}"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Change" Width="0.75*" MinWidth="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Application" Width="1.3*" MinWidth="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding App}" FontWeight="SemiBold" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Monitor" Width="0.7*" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Monitor.Text}" Foreground="{Binding Monitor.Brush}" FontWeight="{Binding Monitor.Weight}" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="State" Width="1*" MinWidth="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding State.Text}" Foreground="{Binding State.Brush}" FontWeight="{Binding State.Weight}" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Position" Width="0.85*" MinWidth="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Position.Text}" Foreground="{Binding Position.Brush}" FontWeight="{Binding Position.Weight}" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Size" Width="0.85*" MinWidth="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Size.Text}" Foreground="{Binding Size.Brush}" FontWeight="{Binding Size.Weight}" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Note" Width="1*" MinWidth="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Note.Text}" Foreground="{Binding Note.Brush}" FontWeight="{Binding Note.Weight}" Style="{StaticResource CellText}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</ui:ThemedWindow>
