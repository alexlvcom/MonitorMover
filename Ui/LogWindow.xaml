<ui:ThemedWindow x:Class="MonitorMover.Ui.LogWindow"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="720" Height="480" MinWidth="480" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel>
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Style="{StaticResource PrimaryButton}"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
        <TextBlock x:Name="Summary" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="20,16">
      <!-- Long lines wrap rather than scroll sideways; only the log itself scrolls. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10" Focusable="False">
        <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                 TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="12.5"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</ui:ThemedWindow>
