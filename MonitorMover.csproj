<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonitorMover</AssemblyName>
    <RootNamespace>MonitorMover</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon in the exe's Win32 resources, so Explorer, the taskbar and
         pinned shortcuts show it without the app running. -->
    <ApplicationIcon>MonitorMover.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Monitor Mover</Product>
    <Version>1.2.1</Version>
    <InformationalVersion>1.2.1</InformationalVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- Same file again as a managed resource, so the windows can use it at runtime. -->
    <EmbeddedResource Include="MonitorMover.ico" LogicalName="MonitorMover.ico" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

</Project>
